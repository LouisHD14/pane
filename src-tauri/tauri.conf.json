{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pane",
  "version": "0.7.0",
  "identifier": "org.gruening.pane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MzNDNkJDNkE3RDZGQzMKUldURGIzMXF2TVl6V0E4ZnJMS2s3MDBacUsvVXVoMlRKSnNIMnJSd3plQmVhK1dlekJmRmNZeTUK",
      "endpoints": ["https://github.com/LouisHD14/pane/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
